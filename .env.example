# AI Provider — set ONE (or both; Bedrock takes priority, Gemini is the fallback)
# ─── Option A: AWS Bedrock (Claude 3 Haiku) ───────────────────────────────────
# Get credentials from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-west-1

# ─── Option B: Google Gemini ──────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Firebase Configuration
# Get your Firebase config from: https://console.firebase.google.com/
# Project Settings > General > Your apps > Firebase SDK snippet > Config
FIREBASE_PROJECT_ID=your_firebase_project_id

# Firebase Service Account Key (JSON string for server-side operations)
# Get from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Stringify the JSON file and paste here, or set the path in production
FIREBASE_SERVICE_ACCOUNT_KEY=

# Upstash Redis — REQUIRED in production.
# Rate limiting, webhook dedupe and cron dedupe all use it. In production, AI
# commands and logins are refused if these are missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta App Dashboard > App settings > Basic. Used to verify the
# X-Hub-Signature-256 header on every webhook. Webhooks are rejected without it.
WHATSAPP_APP_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
# Random string (A-Z, a-z, 0-9, _ and -, up to 256 chars): openssl rand -hex 32
# Must also be passed as secret_token to setWebhook (see registerTelegramWebhook
# in src/lib/messaging.ts). Webhooks are rejected without it.
TELEGRAM_WEBHOOK_SECRET=

# Vercel Cron auth. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Alternative Database: Supabase (if not using Firebase)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# JWT Secret for Authentication
# Generate a secure random string: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Application URL
NEXTAUTH_URL=http://localhost:9002

# Node Environment
NODE_ENV=development
